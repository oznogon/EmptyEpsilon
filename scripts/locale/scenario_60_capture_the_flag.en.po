msgid ""
"Ktzzzsss.\n"
"You will DIEEee weaklingsss!"
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:10997
msgctxt "shipEnemy-comms"
msgid ""
"We wish you no harm, but will harm you if we must.\n"
"End of transmission."
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11004
msgctxt "shipEnemy-comms"
msgid "Stay out of our way, or your death will amuse us extremely!"
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11011
msgctxt "shipEnemy-comms"
msgid ""
"One zero one.\n"
"No binary communication detected.\n"
"Switching to universal speech.\n"
"Generating appropriate response for target from human language archives.\n"
":Do not cross us:\n"
"Communication halted."
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11014
msgctxt "shipEnemy-comms"
msgid "EXECUTE: SELFDESTRUCT"
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11017
msgctxt "shipEnemy-comms"
msgid "Rogue command received. Targeting source."
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11020
msgctxt "shipEnemy-comms"
msgid "External command ignored."
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11025
msgctxt "shipEnemy-comms"
msgid ""
"The hive suffers no threats. Opposition to any of us is opposition to us "
"all.\n"
"Stand down or prepare to donate your corpses toward our nutrition."
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11030
msgctxt "shipEnemy-comms"
msgid "<Transmit 'The Itsy-Bitsy Spider' on all wavelengths>"
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11034
msgctxt "shipEnemy-comms"
msgid "We do not need permission to pluck apart such an insignificant threat."
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11038
msgctxt "shipEnemy-comms"
msgid "The hive has greater priorities than exterminating pests."
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11041
msgctxt "shipEnemy-comms"
msgid "Mind your own business!"
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11061
msgctxt "ship-comms"
msgid ""
"Sorry, we have no time to chat with you.\n"
"We are on an important mission."
msgstr ""

#: scripts/scenario_60_capture_the_flag.lua:11065
msgctxt "ship-comms"
msgid ""
"We have nothing for you.\n"
"Good day."
msgstr ""

