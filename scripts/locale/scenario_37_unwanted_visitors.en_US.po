#: scripts/scenario_37_unwanted_visitors.lua:5426
msgctxt "Exuari1-comms"
msgid "Exuari Exterminates Extraterrestrials"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5431
msgctxt "Exuari1-comms"
msgid ""
"The Exuari have unlimited resources and continually send more ships of "
"greater and greater power and nastier surprises. No victory condition exists"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5436
#: scripts/scenario_37_unwanted_visitors.lua:5465
msgctxt "DispatchOfficeOrders-comms"
msgid "Confirm"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5443
#, lua-format
msgctxt "Exuari1-comms"
msgid ""
"The Exuari are on their way. They will target you and the assets in and "
"around %s"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5455
msgctxt "Exuari2-comms"
msgid "Eliminate Exuari stronghold"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5460
msgctxt "Exuari2-comms"
msgid ""
"The Exuari have unlimited resources, but they are constrained to funnel them "
"through their stronghold. Obtain victory by finding and destroying the "
"Exuari stronghold."
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5468
msgctxt "Exuari2-comms"
msgid "Good luck"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5476
msgctxt "Exuari3-comms"
msgid "Survive Exuari offensive"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5481
msgctxt "Exuari3-comms"
msgid ""
"The Exuari launch their invasion offensive. You must survive their attack. "
"You will have a limited amount of time during which you must survive"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5486
msgctxt "Exuari3-comms"
msgid "15 minutes"
msgstr ""

#: scripts/scenario_37_unwanted_visitors.lua:5494
#: scripts/scenario_37_unwanted_visitors.lua:5510
#: scripts/scenario_37_unwanted_visitors.lua:5526
