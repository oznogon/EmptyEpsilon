msgstr "%s has ordnance we could get:%s."

#: scripts/scenario_44_defenders_or_pirates.lua:11554
#, lua-format
msgctxt "smee-msgRelay"
msgid "%s has nothing we need or want."
msgstr "%s has nothing we need or want."

#: scripts/scenario_44_defenders_or_pirates.lua:11573
msgctxt "smee-msgRelay"
msgid "We need 50 energy per item of loot we want. Looting may fail."
msgstr "We need 50 energy per item of loot we want. Looting may fail."

#: scripts/scenario_44_defenders_or_pirates.lua:11584
msgctxt "smee-msgRelay"
msgid ""
"We've got 50 or more energy. We need 50 per item. Looting will probably "
