msgstr "We've got 50 or more energy. We need 50 per item. Looting will probably succeed."

#: scripts/scenario_44_defenders_or_pirates.lua:11598
msgctxt "smee-msgRelay"
msgid "There are no ships we can loot within three units."
msgstr "There are no ships we can loot within three units."

