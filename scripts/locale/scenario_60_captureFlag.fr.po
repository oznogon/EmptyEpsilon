# Scenario setting
msgctxt "setting"
msgid "Tracking"
msgstr "Information de suivi des drapeaux"

msgctxt "setting"
msgid "Configures information given about flag."
msgstr "Information diffusée lors du largage et capture de drapeaux."

msgctxt "Tracking"
msgid "Normal"
msgstr "Normale"

msgctxt "Tracking"
msgid ""
"Drop: Kraylor or Human Navy flag dropped (main  screen). Grab: The Kraylor "
"or Human Navy picked up your flag (main screen and ship log)"
msgstr ""
"Largage : le nom du camp qui largue un drapeau s'affiche sur l'écran "
"principal.\n"
"Capture : le nom du camp qui capture un drapeau s'affiche sur l'écran "
"principal et journal de bord des vaisseaux."

msgctxt "Tracking"
msgid "Easy"
msgstr "Facile"

msgctxt "Tracking"
msgid ""
"Drop: ShipName dropped Kraylor or Human Navy flag (main screen). Grab: "
"Kraylor or Human Navy ship ShipName picked up your flag (main screen and "
"ship log)"
msgstr ""
"Largage : le nom du vaisseau qui largue un drapeau s'affiche sur l'écran "
"principal.\n"
"Capture : le nom du vaisseau qui capture un drapeau s'affiche sur l'écran "
"principal et journal de bord des vaisseaux."

msgctxt "Tracking"
msgid "Hard"
msgstr "Difficile"

msgctxt "Tracking"
msgid ""
"Drop: Flag dropped (main screen). Grab: Flag obtained (main screen). Flag "
"must be rescanned after drop"
msgstr ""
"Largage : un drapeau largué s'affiche sur l'écran principal.\n"
"Capture : un drapeau capturé s'affiche sur l'écran principal et journal de "
"bord des vaisseaux.\n"
"Après largage, un drapeau doit être scanné à nouveau."

msgctxt "Tracking"
msgid "Secret"
msgstr "Secrète"

msgctxt "Tracking"
msgid ""
"Neither dropping nor grabbing the flag will produce a message. Flag must be "
"rescanned after drop"
msgstr ""
"Aucune information n'est diffusée.\n"
"Après largage, un drapeau doit être scanné à nouveau."

