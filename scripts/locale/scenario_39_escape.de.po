msgid "Got mines for us?"
msgstr "Haben Sie Minen für uns?"

#: scripts/scenario_39_escape.lua:2409
msgctxt "ammo-comms"
msgid "What about HVLI?"
msgstr "Was ist mit HGBIs?"

#: scripts/scenario_39_escape.lua:2410
msgctxt "ammo-comms"
msgid "Could you provide HVLI?"
msgstr "Haben Sie noch HGBIs für uns?"

#: scripts/scenario_39_escape.lua:2413
msgctxt "ammo-comms"
msgid "We need High Velocity Lead Impactors."
msgstr "Wir benötigen Hochgeschwindigkeits-Blei-Impaktoren."

