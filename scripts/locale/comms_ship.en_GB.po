#: scripts/comms_ship.lua:142
msgctxt "shipEnemy-comms"
msgid "We will see to your destruction!"
msgstr "We will see to your destruction!"

#: scripts/comms_ship.lua:144
msgctxt "shipEnemy-comms"
msgid "Your bloodline will end here!"
msgstr "Your bloodline will end here!"

#: scripts/comms_ship.lua:146
msgctxt "shipEnemy-comms"
msgid "Your feeble threats are meaningless."
msgstr "Your feeble threats are meaningless."

#: scripts/comms_ship.lua:150
msgctxt "shipEnemy-comms"
msgid ""
"Ktzzzsss.\n"
"\n"
"You will DIEEee weaklingsss!"
msgstr "Ktzzzsss.\n\nYou will DIEEee weaklingsss!"

#: scripts/comms_ship.lua:157
msgctxt "shipEnemy-comms"
msgid ""
"We wish you no harm, but will harm you if we must.\n"
"\n"
"End of transmission."
msgstr "We wish you no harm, but will harm you if we must.\n\nEnd of transmission."

#: scripts/comms_ship.lua:164
msgctxt "shipEnemy-comms"
msgid "Stay out of our way, or your death will amuse us extremely!"
msgstr "Stay out of our way, or your death will amuse us extremely!"

#: scripts/comms_ship.lua:169
msgctxt "shipEnemy-comms"
msgid ""
"One zero one.\n"
"\n"
"No binary communication detected. Switching to universal speech.\n"
"\n"
"Generating appropriate response for target from human language archives.\n"
"\n"
":Do not cross us.:\n"
"\n"
"Communication halted."
msgstr "One zero one.\n\nNo binary communication detected. Switching to universal speech.\n\nGenerating appropriate response for target from human language archives.\n\n:Do not cross us.:\n\nCommunication halted."

#: scripts/comms_ship.lua:179
msgctxt "shipEnemy-comms"
msgid "EXECUTE: SELFDESTRUCT"
msgstr "EXECUTE: SELFDESTRUCT"

#: scripts/comms_ship.lua:182
msgctxt "shipEnemy-comms"
msgid "Rogue command received. Targeting source."
msgstr "Rogue command received. Targeting source."

#: scripts/comms_ship.lua:185
msgctxt "shipEnemy-comms"
msgid "External command ignored."
msgstr "External command ignored."

#: scripts/comms_ship.lua:189
msgctxt "shipEnemy-comms"
msgid ""
"The hive suffers no threats. Opposition to any of us is opposition to us "
"all.\n"
"\n"
"Stand down or prepare to donate your corpses toward our nutrition."
msgstr "The hive suffers no threats. Opposition to any of us is opposition to us all.\n\nStand down or prepare to donate your corpses toward our nutrition."

#: scripts/comms_ship.lua:195
msgctxt "shipEnemy-comms"
msgid "<Transmits 'The Itsy-Bitsy Spider' on all wavelengths>"
msgstr "<Transmits 'The Itsy-Bitsy Spider' on all wavelengths>"

#: scripts/comms_ship.lua:199
msgctxt "shipEnemy-comms"
msgid "We do not need permission to pluck apart such an insignificant threat."
msgstr "We do not need permission to pluck apart such an insignificant threat."

#: scripts/comms_ship.lua:203
msgctxt "shipEnemy-comms"
msgid "The hive has greater priorities than exterminating pests."
msgstr "The hive has greater priorities than exterminating pests."

#: scripts/comms_ship.lua:206
msgctxt "shipEnemy-comms"
msgid "Mind your own business!"
msgstr "Mind your own business!"

#: scripts/comms_ship.lua:233
msgctxt "ship-comms"
msgid ""
"Sorry, we have no time to chat with you.\n"
"\n"
"We are on an important mission."
msgstr "Sorry, we have no time to chat with you.\n\nWe are on an important mission."

#: scripts/comms_ship.lua:240
msgctxt "ship-comms"
msgid ""
"We have nothing for you.\n"
"\n"
"Good day."
msgstr "We have nothing for you.\n\nGood day."

