#: scripts/scenario_42_borderline_fever.lua:13575
msgctxt "upgrade-comms"
msgid "Increase spin speed"
msgstr "Augmenter la vitesse de rotation"

#: scripts/scenario_42_borderline_fever.lua:13606
#, lua-format
msgctxt "upgrade-comms"
msgid "Ship spin speed increased by %i%% after you gave %s to %s"
msgstr ""
"La vitesse de rotation du vaisseau a augmenté de %i%% après avoir donné la "
"marchandise %s à %s."

#: scripts/scenario_42_borderline_fever.lua:13618
#, lua-format
msgctxt "upgrade-comms"
msgid "%s requires %s for the spin upgrade"
msgstr "%s a besoin de %s pour la mise à niveau de la vitesse de rotation."

#: scripts/scenario_42_borderline_fever.lua:13634
#, lua-format
msgctxt "upgrade-comms"
msgid ""
"%s: I increased the speed your ship spins by 50%%. Normally, I'd require %s, "
"but seeing as you're going out to take on the Kraylors, we worked it out"
msgstr ""
"%s : J'ai augmenté la vitesse de rotation de votre vaisseau de 50%%.\n"
"Normalement, je vous demanderai du %s, mais comme vous comptez affronter les "
"Kraylors, nous nous sommes arrangés."

#: scripts/scenario_42_borderline_fever.lua:13647
msgctxt "upgrade-comms"
msgid "Add missle tube"
msgstr "Ajouter un tube lance-missiles"

#: scripts/scenario_42_borderline_fever.lua:13704
#, lua-format
msgctxt "upgrade-comms"
msgid ""
"%s thanks you for the %s and the luxury and installs a homing missile tube "
"for you"
msgstr ""
"...%s vous remercie pour le %s et les produits de luxe et installe un tube "
"lance-missiles à tête chercheuse pour vous."

#: scripts/scenario_42_borderline_fever.lua:13715
#, lua-format
msgctxt "upgrade-comms"
msgid "%s requires %s and luxury for the missile tube"
msgstr "%s réclame du %s et des produits de luxe pour le tube lance-missiles."

#: scripts/scenario_42_borderline_fever.lua:13740
#, lua-format
msgctxt "upgrade-comms"
msgid ""
"%s installs a homing missile tube for you. The %s required was requisitioned "
"from wartime contingency supplies"
msgstr ""
"...%s installe un tube lance-missiles à tête chercheuse pour vous. Le %s "
"requis a été réquisitionné à partir de fournitures d'urgence en temps de "
"guerre."

#: scripts/scenario_42_borderline_fever.lua:13753
msgctxt "upgrade-comms"
msgid "Reduce beam heat"
msgstr "Réduire la chaleur des faisceaux laser"

#: scripts/scenario_42_borderline_fever.lua:13791
#, lua-format
msgctxt "upgrade-comms"
msgid "Beam heat generation reduced by %i%%"
msgstr "Production de chaleur des faisceaux laser réduite de %i%%."

#: scripts/scenario_42_borderline_fever.lua:13801
#, lua-format
msgctxt "upgrade-comms"
msgid "%s says she needs %s before she can cool your beams"
msgstr ""
"%s dit qu'elle a besoin de %s avant de pouvoir refroidir vos faisceaux laser."

#: scripts/scenario_42_borderline_fever.lua:13822
#, lua-format
msgctxt "upgrade-comms"
msgid ""
"%s: Beam heat generation reduced by 50%%, no %s necessary. Go shoot some "
"Kraylors for me"
msgstr ""
