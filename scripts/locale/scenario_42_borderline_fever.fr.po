msgid "Scan to gather intelligence"
msgstr "Scanner pour recueillir des renseignements"

#: scripts/scenario_42_borderline_fever.lua:12076
#: scripts/scenario_42_borderline_fever.lua:12107
#: scripts/scenario_42_borderline_fever.lua:12138
