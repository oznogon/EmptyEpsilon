# Scenario name
msgid "Basic Battle"
msgstr "Basic Battle"

# Scenario description
msgid ""
"A few random stations are under attack by enemies, with random terrain "
"around them. Destroy all enemies to win.\n"
"\n"
"The scenario provides a single player-controlled Atlantis, which is "
"sufficient to win even in the \"Extreme\" variant.\n"
"\n"
"Other player ships can be spawned, but the strength of enemy ships is "
"independent of the number and types of player ships."
msgstr "A few random stations are under attack by enemies, with random terrain around them. Destroy all enemies to win.\n\nThe scenario provides a single player-controlled Atlantis, which is sufficient to win even in the \"Extreme\" variant.\n\nOther player ships can be spawned, but the strength of enemy ships is independent of the number and types of player ships."

# Scenario setting
msgctxt "setting"
msgid "Enemies"
msgstr "Enemies"

msgctxt "setting"
msgid "Configures the amount of enemies spawned in the scenario."
msgstr "Configures the amount of enemies spawned in the scenario."

msgctxt "Enemies"
msgid "Empty"
msgstr "Empty"

msgctxt "Enemies"
msgid ""
"No enemies. Recommended for GM-controlled scenarios and rookie crew "
"orientation. The scenario continues until the GM declares victory or all "
"Human Navy ships are destroyed."
msgstr "No enemies. Recommended for GM-controlled scenarios and rookie crew orientation. The scenario continues until the GM declares victory or all Human Navy ships are destroyed."

msgctxt "Enemies"
msgid "Easy"
msgstr "Easy"

msgctxt "Enemies"
msgid "Fewer enemies. Recommended for inexperienced crews."
msgstr "Fewer enemies. Recommended for inexperienced crews."

msgctxt "Enemies"
msgid "Normal"
msgstr "Normal"

msgctxt "Enemies"
msgid "Normal amount of enemies. Recommended for a normal crew."
msgstr "Normal amount of enemies. Recommended for a normal crew."

msgctxt "Enemies"
msgid "Hard"
msgstr "Hard"

msgctxt "Enemies"
msgid "More enemies. Recommended if you have multiple player-controlled ships."
msgstr "More enemies. Recommended if you have multiple player-controlled ships."

msgctxt "Enemies"
msgid "Extreme"
msgstr "Extreme"

msgctxt "Enemies"
msgid ""
"Many enemies. Inexperienced player crews will pretty surely be overwhelmed."
msgstr "Many enemies. Inexperienced player crews will pretty surely be overwhelmed."

