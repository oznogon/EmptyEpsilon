#: scripts/scenario_37_unwanted_visitors.lua:6291
#, lua-format
msgctxt "ammo-comms"
msgid ""
"%s\n"
"We don't have ordnance for you."
msgstr ""
"%s\n"
"Nous n'avons pas de munitions pour vous."

#: scripts/scenario_37_unwanted_visitors.lua:6302
#: scripts/scenario_37_unwanted_visitors.lua:6442
#: scripts/scenario_37_unwanted_visitors.lua:6597
msgctxt "DispatchOffice-comms"
msgid "Visit dispatch office"
msgstr "Visiter le bureau central"

#: scripts/scenario_37_unwanted_visitors.lua:6308
#, lua-format
msgctxt "DispatchOffice-comms"
msgid ""
"Excellent work on your last assignment, %s. You may stand down or take "
"another assignment"
msgstr ""
"Excellent travail sur votre dernière mission, %s.\n"
"Vous pouvez vous retirer ou accepter une autre mission."

#: scripts/scenario_37_unwanted_visitors.lua:6315
#: scripts/scenario_37_unwanted_visitors.lua:6574
#: scripts/scenario_37_unwanted_visitors.lua:6722
msgctxt "DispatchOffice-comms"
msgid "Stand down"
msgstr "Démissionner"

#: scripts/scenario_37_unwanted_visitors.lua:6320
#: scripts/scenario_37_unwanted_visitors.lua:6579
#: scripts/scenario_37_unwanted_visitors.lua:6727
msgctxt "DispatchOffice-comms"
msgid "Congratulations and thank you"
msgstr "Félicitations et merci"

#: scripts/scenario_37_unwanted_visitors.lua:6332
msgctxt "DispatchOffice-comms"
msgid "Move to next region of available missions"
msgstr "Passer à la région suivante des missions disponibles."

#: scripts/scenario_37_unwanted_visitors.lua:6339
#: scripts/scenario_37_unwanted_visitors.lua:6402
#, lua-format
msgctxt "DispatchOffice-comms"
msgid ""
"Dock with station %s for the details of your next assignment. Beware the "
"asteroids"
msgstr ""
"Amarrez-vous à la station %s pour les détails de votre prochaine mission.\n"
"Attention aux astéroïdes."

#: scripts/scenario_37_unwanted_visitors.lua:6350
#: scripts/scenario_37_unwanted_visitors.lua:6413
#: scripts/scenario_37_unwanted_visitors.lua:6485
#: scripts/scenario_37_unwanted_visitors.lua:6554
#, lua-format
msgctxt "DispatchOffice-comms"
msgid "Dock with station %s"
msgstr "S'amarrer à la station %s"

#: scripts/scenario_37_unwanted_visitors.lua:6361
#: scripts/scenario_37_unwanted_visitors.lua:6395
#: scripts/scenario_37_unwanted_visitors.lua:6496
#: scripts/scenario_37_unwanted_visitors.lua:6531
msgctxt "DispatchOffice-comms"
msgid "Request next assignment"
msgstr "Consulter la prochaine mission"

#: scripts/scenario_37_unwanted_visitors.lua:6448
#, lua-format
msgctxt "DispatchOffice-comms"
msgid ""
"Welcome to %s station, %s. We're glad you're here. These are your choices "
"for assignments"
msgstr ""
"Bienvenue sur la station %s, %s. Nous sommes heureux de vous accueillir "
"parmi nous.\n"
"Vous pouvez choisir vos missions :"

#: scripts/scenario_37_unwanted_visitors.lua:6460
#, lua-format
msgctxt "DispatchOffice-comms"
msgid "Move on to missions in %s area"
msgstr "Passer aux missions de la zone %s"

#: scripts/scenario_37_unwanted_visitors.lua:6469
#: scripts/scenario_37_unwanted_visitors.lua:6538
#, lua-format
msgctxt "DispatchOffice-comms"
msgid "Dock with station %s for your next assignment"
msgstr "Amarrez-vous à la station %s pour votre prochaine mission."

#: scripts/scenario_37_unwanted_visitors.lua:6603
#, lua-format
msgctxt "DispatchOffice-comms"
msgid ""
"Welcome, %s. Everything is bigger at %s station. We could use your help with "
"one of these mission options"
msgstr ""
"Bienvenue, %s.\n"
"Tout est plus grand à la station %s. Nous pourrions avoir besoin de votre "
"aide avec l'une de ces options de mission :"

#: scripts/scenario_37_unwanted_visitors.lua:6611
msgctxt "Exuari1-comms"
msgid "Exuari Exterminates Extraterrestrials"
msgstr "Les Éxuaris exterminent les extraterrestres"

#: scripts/scenario_37_unwanted_visitors.lua:6616
msgctxt "Exuari1-comms"
msgid ""
"The Exuari have unlimited resources and continually send more ships of "
"greater and greater power and nastier surprises. No victory condition exists"
msgstr ""
"Les Éxuaris disposent de ressources illimitées et envoient continuellement "
"de plus en plus de vaisseaux toujours plus puissants et de plus en plus de "
"mauvaises surprises. Aucune condition de victoire n'existe."

#: scripts/scenario_37_unwanted_visitors.lua:6621
#: scripts/scenario_37_unwanted_visitors.lua:6650
msgctxt "DispatchOfficeOrders-comms"
msgid "Confirm"
msgstr "Confirmer"

#: scripts/scenario_37_unwanted_visitors.lua:6628
#, lua-format
msgctxt "Exuari1-comms"
msgid ""
"The Exuari are on their way. They will target you and the assets in and "
"around %s"
msgstr ""
"Les Éxuaris sont en route. Ils vous cibleront ainsi que tout ce qui se "
"trouve dans et autour de %s."

#: scripts/scenario_37_unwanted_visitors.lua:6640
msgctxt "Exuari2-comms"
msgid "Eliminate Exuari stronghold"
msgstr "Éliminer la forteresse Éxuarie"

#: scripts/scenario_37_unwanted_visitors.lua:6645
msgctxt "Exuari2-comms"
msgid ""
"The Exuari have unlimited resources, but they are constrained to funnel them "
"through their stronghold. Obtain victory by finding and destroying the "
"Exuari stronghold."
msgstr ""
"Les Éxuaris disposent de ressources illimitées, mais ils sont contraints de "
"les canaliser vers leur forteresse.\n"
"Obtenez la victoire en trouvant et en détruisant cette forteresse."

#: scripts/scenario_37_unwanted_visitors.lua:6653
msgctxt "Exuari2-comms"
msgid "Good luck"
msgstr "Bonne chance."

#: scripts/scenario_37_unwanted_visitors.lua:6661
msgctxt "Exuari3-comms"
msgid "Survive Exuari offensive"
msgstr "Survivre à l'offensive Éxuarie"

#: scripts/scenario_37_unwanted_visitors.lua:6666
msgctxt "Exuari3-comms"
msgid ""
"The Exuari launch their invasion offensive. You must survive their attack. "
"You will have a limited amount of time during which you must survive"
msgstr ""
"Les Éxuaris lancent leur offensive d'invasion.\n"
"Vous devez survivre à leur attaque. Vous disposerez d'un temps limité "
"pendant lequel vous devrez survivre."

#: scripts/scenario_37_unwanted_visitors.lua:6671
msgctxt "Exuari3-comms"
msgid "15 minutes"
msgstr "15 minutes"

#: scripts/scenario_37_unwanted_visitors.lua:6679
#: scripts/scenario_37_unwanted_visitors.lua:6695
#: scripts/scenario_37_unwanted_visitors.lua:6711
msgctxt "Exuari3-comms"
msgid "The countdown has begun"
msgstr "Le compte à rebours a commencé."

#: scripts/scenario_37_unwanted_visitors.lua:6687
msgctxt "Exuari3-comms"
msgid "30 minutes"
msgstr "30 minutes"

#: scripts/scenario_37_unwanted_visitors.lua:6703
msgctxt "Exuari3-comms"
msgid "45 minutes"
msgstr "45 minutes"

#: scripts/scenario_37_unwanted_visitors.lua:6745
msgctxt "Polly-comms"
msgid "Pick up astronomer Polly Hobbs"
msgstr "Récupérez l'astronome Polly Hobbs"

#: scripts/scenario_37_unwanted_visitors.lua:6750
msgctxt "Polly-comms"
msgid ""
"[Polly Hobbs] Thank you for picking me up. I found the source of the "
"anomalous readings near the end of the inner solar asteroid belt. I've "
"brought specialized scanning instruments, but they must be closer than 1 "
"unit to be effective. Also, we will need baseline scan data from your ship's "
"instruments"
msgstr ""
"[Polly Hobbs]\n"
"Merci d'être venue me chercher. J'ai trouvé la source des lectures anormales "
"près de l'extrémité de la ceinture interne d'astéroïdes solaires. J'ai "
"apporté des instruments de scannérisation spécialisés, mais ils doivent se "
"trouver à moins d'1 unité de leur cible pour être efficaces. Nous aurons "
"également besoin des données d'analyse de base provenant des instruments de "
"votre vaisseau."

#: scripts/scenario_37_unwanted_visitors.lua:6756
msgctxt "Polly-comms"
msgid ""
"Bring astronomer Polly Hobbs close to artifact for additional sensor readings"
msgstr ""
"Rapprochez l'astronome Polly Hobbs de l'artefact afin d'obtenir des lectures "
"supplémentaires du capteur."

#: scripts/scenario_37_unwanted_visitors.lua:6770
msgctxt "planetologist-comms"
msgid "Pick up planetologist"
msgstr "Récupérer le planétologue"

#: scripts/scenario_37_unwanted_visitors.lua:6775
msgctxt "planetologist-comms"
msgid ""
"I'm not sure he's ready. He's not at the dock ready to board or in the "
"transporter room. Our station is undergoing repairs, so several systems are "
"offline"
msgstr ""
"Je ne suis pas sûr qu'il soit prêt. Il n'est pas sur le quai prêt à "
"embarquer ou dans la salle de téléportation. Notre station est en cours de "
"réparation, donc plusieurs systèmes sont hors ligne."

#: scripts/scenario_37_unwanted_visitors.lua:6779
msgctxt "planetologist-comms"
msgid "Look for planetologist"
msgstr "Rechercher le planétologue"

#: scripts/scenario_37_unwanted_visitors.lua:6784
msgctxt "planetologist-comms"
msgid ""
"The likeliest places to find him are his quarters, the lab or the "
"observation lounge"
msgstr ""
"Les endroits les plus susceptibles où le trouver sont ses quartiers, le "
"laboratoire ou le salon d'observation."

#: scripts/scenario_37_unwanted_visitors.lua:6788
msgctxt "planetologist-comms"
msgid "Try his quarters"
msgstr "Essayer ses quartiers"

#: scripts/scenario_37_unwanted_visitors.lua:6801
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Yes? What can I do for you? Please be quick about it, "
"I'm in a bit of a hurry"
msgstr ""
"[Enrique Flogistan]\n"
"Oui ? Que puis-je faire pour vous ? Faites vite, je suis un peu pressé."

#: scripts/scenario_37_unwanted_visitors.lua:6809
#, lua-format
msgctxt "planetologist-comms"
msgid "Ready to begin your observations of %s?"
msgstr "Prêt à commencer vos observations sur %s ?"

#: scripts/scenario_37_unwanted_visitors.lua:6827
#, lua-format
msgctxt "planetologist-comms"
msgid "[Enrique Flogistan] Almost. Let me grab something from %s"
msgstr ""
"[Enrique Flogistan]\n"
"Presque. Laisse-moi prendre quelque chose dans %s."

#: scripts/scenario_37_unwanted_visitors.lua:6842
#, lua-format
msgctxt "planetologist-comms"
msgid "We are here to transport you to %s"
msgstr "Nous sommes là pour vous transporter sur %s."

#: scripts/scenario_37_unwanted_visitors.lua:6858
#, lua-format
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] You're not my normal transport representative. Besides, "
"I still need to pack a few things.\n"
"\n"
"He heads off down the corridor towards %s"
msgstr ""
"[Enrique Flogistan]\n"
"Vous n'êtes pas mon représentant habituel en matière de transport. De plus, "
"je dois encore faire quelques bagages.\n"
"\n"
"...Il se dirige vers le couloir en direction de %s."

#: scripts/scenario_37_unwanted_visitors.lua:6874
#, lua-format
msgctxt "planetologist-comms"
msgid "My ship, %s, is here to transport you"
msgstr "Mon vaisseau, %s, est là pour vous transporter."

#: scripts/scenario_37_unwanted_visitors.lua:6882
msgctxt "planetologist-comms"
msgid "Is your ship armed?"
msgstr "Votre vaisseau est-il armé ?"

#: scripts/scenario_37_unwanted_visitors.lua:6889
msgctxt "planetologist-comms"
msgid "Yes, we can handle any Exuari in the area"
msgstr "Oui, nous pouvons gérer n'importe quel vaisseau Éxuari dans la région."

#: scripts/scenario_37_unwanted_visitors.lua:6912
#: scripts/scenario_37_unwanted_visitors.lua:7640
msgctxt "planetologist-comms"
msgid "He's already boarded a ship"
msgstr "...Il est déjà monté à bord d'un vaisseau."

#: scripts/scenario_37_unwanted_visitors.lua:6919
msgctxt "planetologist-comms"
msgid ""
"Good. Let's go\n"
"\n"
"He joins you as you go back to the ship"
msgstr ""
"[Enrique Flogistan]\n"
"Bien. Allons-y\n"
"\n"
"...Il vous rejoint alors que vous retournez au vaisseau."

#: scripts/scenario_37_unwanted_visitors.lua:6932
#, lua-format
msgctxt "planetologist-comms"
msgid "Good. I still need a couple of items from %s"
msgstr ""
"[Enrique Flogistan]\n"
"Bien. J'ai encore besoin de quelques articles dans %s."

#: scripts/scenario_37_unwanted_visitors.lua:6972
#, lua-format
msgctxt "planetologist-comms"
msgid ""
"He's not in his quarters. His digital room assistant predicts he went to %s"
msgstr ""
"...Il n'est pas dans ses quartiers. Son assistant numérique prédit qu'il est "
"allé dans %s."

#: scripts/scenario_37_unwanted_visitors.lua:6982
msgctxt "planetologist-comms"
msgid "Try the lab"
msgstr "Essayer le laboratoire"

#: scripts/scenario_37_unwanted_visitors.lua:6993
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Hello, welcome to the planetology lab. Can I help you?"
msgstr ""
"[Enrique Flogistan]\n"
"Bonjour. Bienvenue au laboratoire de planétologie. Comment puis-je vous "
"aider ?"

#: scripts/scenario_37_unwanted_visitors.lua:7001
#, lua-format
msgctxt "planetologist-comms"
msgid "Ready to go observe %s?"
msgstr "Prêt à aller observer %s ?"

#: scripts/scenario_37_unwanted_visitors.lua:7017
#, lua-format
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Almost. Let me get one more thing.\n"
"\n"
"He leaves the lab for %s"
msgstr ""
"[Enrique Flogistan]\n"
"Presque. Laissez-moi vous donner encore une chose.\n"
"\n"
"...Il quitte le laboratoire pour %s."

#: scripts/scenario_37_unwanted_visitors.lua:7033
#, lua-format
msgctxt "planetologist-comms"
msgid "We're ready to transport you to %s"
msgstr "Nous sommes prêts à vous transporter sur %s"

#: scripts/scenario_37_unwanted_visitors.lua:7050
#, lua-format
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Already?!\n"
"\n"
"He quickly leaves the lab. The lab technician looks over as he leaves\n"
"\n"
"[Lab technician] I think he's going to %s"
msgstr ""
"[Enrique Flogistan]\n"
"Déjà ?!\n"
"\n"
"...Il quitte rapidement le laboratoire. Le technicien de laboratoire le "
"regarde en partant\n"
"\n"
"[Technicien de laboratoire]\n"
"Je pense qu'il va dans %s."

#: scripts/scenario_37_unwanted_visitors.lua:7071
#, lua-format
msgctxt "planetologist-comms"
msgid "%s has docked and is waiting on you"
msgstr "%s est amarré et vous attend"

#: scripts/scenario_37_unwanted_visitors.lua:7079
msgctxt "planetologist-comms"
msgid "Are you aware of the Exuari that have been spotted in the area?"
msgstr ""
"Avez-vous connaissance des Éxuaris qui ont été repérés dans la région ?"

#: scripts/scenario_37_unwanted_visitors.lua:7086
msgctxt "planetologist-comms"
msgid "Yes, don't worry about them"
msgstr "Oui, ne vous souciez pas d'eux"

#: scripts/scenario_37_unwanted_visitors.lua:7093
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Good to know. I need to finishing packing in my quarters"
msgstr ""
"[Enrique Flogistan]\n"
"Bon à savoir. Je dois finir de faire mes valises dans mes quartiers."

#: scripts/scenario_37_unwanted_visitors.lua:7103
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Good to know. I left some notes in the observation lounge"
msgstr ""
"[Enrique Flogistan]\n"
"Bon à savoir. J'ai laissé quelques notes dans le salon d'observation."

#: scripts/scenario_37_unwanted_visitors.lua:7136
#, lua-format
msgctxt "planetologist-comms"
msgid ""
"[Lab technician] You just missed him. I think he said he was going to %s"
msgstr ""
"[Technicien de laboratoire]\n"
"Tu l'as raté de peu. Je crois qu'il a dit qu'il allait dans %s."

#: scripts/scenario_37_unwanted_visitors.lua:7146
msgctxt "planetologist-comms"
msgid "Try observation lounge"
msgstr "Essayer le salon d'observation"

#: scripts/scenario_37_unwanted_visitors.lua:7170
#, lua-format
msgctxt "planetologist-comms"
msgid "[Enrique Flogistan] Just take in the gorgeous view of %s from here"
msgstr ""
"[Enrique Flogistan]\n"
"Admirez la magnifique vue sur %s depuis ici."

#: scripts/scenario_37_unwanted_visitors.lua:7180
#, lua-format
msgctxt "planetologist-comms"
msgid "Ready for a closer view of %s?"
msgstr "Prêt pour une vue rapprochée de %s ?"

#: scripts/scenario_37_unwanted_visitors.lua:7199
#, lua-format
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Just about. I forgot to pack something.\n"
"\n"
"He leaves the observation lounge to go to %s"
msgstr ""
"[Enrique Flogistan]\n"
"Presque. J'ai oublié d'emporter quelque chose.\n"
"\n"
"...Il quitte la salle d'observation pour se rendre dans %s."

#: scripts/scenario_37_unwanted_visitors.lua:7215
#, lua-format
msgctxt "planetologist-comms"
msgid "We're ready to take you to %s"
msgstr "Nous sommes prêts à vous emmener sur %s."

#: scripts/scenario_37_unwanted_visitors.lua:7227
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Well I'm not. I just need a few more items from my "
"quarters"
msgstr ""
"[Enrique Flogistan]\n"
"Eh bien, je ne le suis pas. J'ai encore besoin de récupérer quelques "
"affaires à mon appartement."

#: scripts/scenario_37_unwanted_visitors.lua:7237
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] Well I'm not. I just need a few more items from the lab"
msgstr ""
"[Enrique Flogistan]\n"
"Eh bien, je ne le suis pas. J'ai encore besoin de récupérer quelques "
"affaires au laboratoire."

#: scripts/scenario_37_unwanted_visitors.lua:7254
#, lua-format
msgctxt "planetologist-comms"
msgid "%s has been ordered to get you to %s"
msgstr "%s a reçu l'ordre de vous amener à %s"

#: scripts/scenario_37_unwanted_visitors.lua:7266
msgctxt "planetologist-comms"
msgid ""
"I heard about your encounter with the Exuari. You know they could come back, "
"right?"
msgstr ""
"[Enrique Flogistan]\n"
"J'ai entendu parler de votre rencontre avec les Éxuaris. Vous savez qu'ils "
"pourraient revenir, n'est-ce pas ?"

#: scripts/scenario_37_unwanted_visitors.lua:7273
msgctxt "planetologist-comms"
msgid "Certainly. We'll be ready, don't worry"
msgstr "Bien sûr, nous serons prêts, ne vous inquiétez pas"

#: scripts/scenario_37_unwanted_visitors.lua:7280
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] I admire your confidence. I'll get my things from my "
"quarters"
msgstr ""
"[Enrique Flogistan]\n"
"J'admire votre confiance. Je vais chercher mes affaires dans mon appartement."

#: scripts/scenario_37_unwanted_visitors.lua:7290
msgctxt "planetologist-comms"
msgid ""
"[Enrique Flogistan] I admire your confidence. I'll get my research material "
"from the lab"
msgstr ""
"[Enrique Flogistan]\n"
"J'admire votre confiance. Je vais chercher mon matériel de recherche au "
"laboratoire."

#: scripts/scenario_37_unwanted_visitors.lua:7325
#, lua-format
msgctxt "planetologist-comms"
msgid "[Station repair crewman] He just left for %s"
msgstr ""
"[Membre de l'équipe de réparation de la station]\n"
"Il vient de partir pour %s."

#: scripts/scenario_37_unwanted_visitors.lua:7338
msgctxt "planetologist-comms"
msgid "Contact planetologist directly"
msgstr "Contacter directement le planétologue"

#: scripts/scenario_37_unwanted_visitors.lua:7343
msgctxt "planetologist-comms"
msgid "Repair work prevents contact with individual"
msgstr "Les travaux de réparation empêchent tout contact avec les personnes."

#: scripts/scenario_37_unwanted_visitors.lua:7349
msgctxt "planetologist-comms"
msgid "Contact Enrique Flogistan's quarters"
msgstr "Contacter le quartier d'Enrique Flogistan"

#: scripts/scenario_37_unwanted_visitors.lua:7356
msgctxt "planetologist-comms"
msgid "[Enrique Flogistan] Who is it?"
msgstr ""
"[Enrique Flogistan]\n"
"Qui est-ce ?"

#: scripts/scenario_37_unwanted_visitors.lua:7365
#, lua-format
msgctxt "planetologist-comms"
msgid "This is %s. We are your transportation to %s"
msgstr "Ici %s. Nous sommes votre moyen de transport pour %s"

#: scripts/scenario_37_unwanted_visitors.lua:7384
#, lua-format
msgctxt "planetologist-comms"
msgid "I'm going to %s before we leave"
msgstr ""
"[Enrique Flogistan]\n"
"Je dois aller dans %s avant de partir."

#: scripts/scenario_37_unwanted_visitors.lua:7408
msgctxt "planetologist-comms"
msgid "No reply from Enrique Flogistan's quarters"
msgstr "Aucune réponse du bureau d'Enrique Flogistan"

#: scripts/scenario_37_unwanted_visitors.lua:7416
msgctxt "planetologist-comms"
msgid "Contact planetology lab"
msgstr "Contacter le laboratoire de planétologie"

#: scripts/scenario_37_unwanted_visitors.lua:7433
#, lua-format
msgctxt "planetologist-comms"
msgid ""
"A lab technician answers and tells you Enrique Flogistan is probably going "
"to %s"
msgstr ""
"...Un technicien de laboratoire répond et vous dit qu'Enrique Flogistan est "
"probablement en route pour %s."

#: scripts/scenario_37_unwanted_visitors.lua:7444
msgctxt "planetologist-comms"
msgid "Contact observation lounge"
msgstr "Contacter le salon d'observation"

#: scripts/scenario_37_unwanted_visitors.lua:7464
#, lua-format
msgctxt "planetologist-comms"
msgid ""
"A repair crewman answers and tells you Enrique Flogistan is probably going "
"to %s"
msgstr ""
"...Un réparateur répond et vous dit qu'Enrique Flogistan est probablement "
"dans %s."

#: scripts/scenario_37_unwanted_visitors.lua:7473
msgctxt "planetologist-comms"
msgid "Contact station galley"
msgstr "Contacter la cuisine de la station"

#: scripts/scenario_37_unwanted_visitors.lua:7479
msgctxt "planetologist-comms"
msgid "[Cook] Hello, who's there?"
msgstr ""
"[Cuisinier]\n"
"Bonjour, qui est là ?"

#: scripts/scenario_37_unwanted_visitors.lua:7487
#, lua-format
msgctxt "planetologist-comms"
msgid "I'm from %s. I'm looking for Enrique Flogistan"
msgstr "Je viens de %s. Je cherche Enrique Flogistan"

#: scripts/scenario_37_unwanted_visitors.lua:7495
msgctxt "planetologist-comms"
msgid ""
"He was here about an hour ago. You might try his quarters, the observation "
"lounge or the lab"
msgstr ""
"[Cuisinier]\n"
"Il était ici il y a environ une heure. Vous pourriez essayer ses quartiers, "
"le salon d'observation ou le laboratoire."

#: scripts/scenario_37_unwanted_visitors.lua:7508
msgctxt "planetologist-comms"
msgid "Contact station security office"
msgstr "Contacter le poste de sécurité de la station"

#: scripts/scenario_37_unwanted_visitors.lua:7515
msgctxt "planetologist-comms"
msgid "[Security officer] May I help you?"
msgstr ""
"[Agent de sécurité]\n"
"Puis-je vous aider ?"

#: scripts/scenario_37_unwanted_visitors.lua:7522
msgctxt "planetologist-comms"
msgid "I'm looking for Enrique Flogistan"
msgstr "Je recherche Enrique Flogistan"

#: scripts/scenario_37_unwanted_visitors.lua:7529
msgctxt "planetologist-comms"
msgid ""
"He's not here in the security office. Our records show he often frequents "
"his quarters, the observation lounge and the planetology lab"
msgstr ""
"[Agent de sécurité]\n"
"Il n'est pas ici, au bureau de sécurité. Nos archives montrent qu'il "
"fréquente souvent ses quartiers, le salon d'observation et le laboratoire de "
"planétologie."

#: scripts/scenario_37_unwanted_visitors.lua:7541
msgctxt "planetologist-comms"
msgid "Contact station maintenance office"
msgstr "Contacter le bureau d'entretien de la station"

#: scripts/scenario_37_unwanted_visitors.lua:7548
msgctxt "planetologist-comms"
msgid "[Maintenance technician] Hi, what's broken?"
msgstr ""
"[Technicien de maintenance]\n"
"Salut, qu'est-ce qui est cassé ?"

#: scripts/scenario_37_unwanted_visitors.lua:7555
msgctxt "planetologist-comms"
msgid "Nothing. I'm looking for Enrique Flogistan"
msgstr ""
"Bonjour,\n"
"Rien du tout, je cherche seulement Enrique Flogistan."

#: scripts/scenario_37_unwanted_visitors.lua:7562
msgctxt "planetologist-comms"
msgid "He's not here. Good luck finding him"
msgstr ""
"Il n'est pas là.\n"
"Bonne chance pour le trouver."

#: scripts/scenario_37_unwanted_visitors.lua:7574
msgctxt "planetologist-comms"
msgid "Contact station operations office"
msgstr "Contacter le bureau des opérations de la station"

#: scripts/scenario_37_unwanted_visitors.lua:7581
msgctxt "planetologist-comms"
msgid "[Operations manager] Yes?"
msgstr ""
"[Responsable des opérations]\n"
"Oui ?"

#: scripts/scenario_37_unwanted_visitors.lua:7588
msgctxt "planetologist-comms"
msgid "Can you help me find Enrique Flogistan?"
msgstr "Pouvez-vous m'aider à retrouver Enrique Flogistan ?"

#: scripts/scenario_37_unwanted_visitors.lua:7595
msgctxt "planetologist-comms"
msgid ""
"He's not here in operations. We are short handed right now with all the "
"repairs going on. I'm afraid you'll have to find him yourself"
msgstr ""
"[Responsable des opérations]\n"
"Il n'est pas ici. Nous sommes actuellement à court de personnel avec toutes "
"les réparations en cours. Je ne peux pas vous aider.\n"
"J'ai peur que vous ne deviez le trouver vous-même."

#: scripts/scenario_37_unwanted_visitors.lua:7607
msgctxt "planetologist-comms"
msgid "Scan for planetologist"
msgstr "Rechercher un planétologue"

#: scripts/scenario_37_unwanted_visitors.lua:7621
#, lua-format
msgctxt "planetologist-comms"
msgid "Sensors show him in %s"
msgstr "Les capteurs indiquent qu'il se trouve dans %s."

#: scripts/scenario_37_unwanted_visitors.lua:7630
#, lua-format
msgctxt "planetologist-comms"
msgid "Beam him over from %s"
msgstr "Le transporter depuis %s"

#: scripts/scenario_37_unwanted_visitors.lua:7647
msgctxt "planetologist-comms"
msgid "He has been beamed aboard"
msgstr "...Enrique Flogistan a bien été téléporté à bord."

#: scripts/scenario_37_unwanted_visitors.lua:7657
msgctxt "planetologist-comms"
msgid "Interference from station repairs prevents a transporter lock"
msgstr ""
"L'interférence des réparations de la station empêche le verrouillage du "
"transporteur."

#: scripts/scenario_37_unwanted_visitors.lua:7676
msgctxt "satellites-comms"
msgid "Satellite problems?"
msgstr "Des problèmes de satellites ?"

#: scripts/scenario_37_unwanted_visitors.lua:7681
#, lua-format
msgctxt "satellites-comms"
msgid ""
"Yes. Our technicians have tracked back the problem to a faulty relay module. "
"However, They are unable to fix it with available parts. They need %s. "
"They've requested delivery, but hear it will take weeks before the next "
"delivery cycle. I don't suppose you could bring us what we need?"
msgstr ""
"Oui. Nos techniciens ont remonté le problème à un module relais défectueux. "
"Cependant, ils ne parviennent pas à le réparer avec les pièces disponibles. "
"Ils ont besoin de %s. Ils ont demandé la livraison, mais ils apprennent que "
"cela prendra des semaines avant le prochain cycle de livraison.\n"
"Je ne pense pas que vous puissiez nous apporter ce dont nous avons besoin ?"

#: scripts/scenario_37_unwanted_visitors.lua:7712
#: scripts/scenario_37_unwanted_visitors.lua:7850
#, lua-format
msgctxt "satellites-comms"
msgid "Provide %s"
msgstr "Fournir du %s"

#: scripts/scenario_37_unwanted_visitors.lua:7723
msgctxt "satellites-comms"
msgid "Thanks. With your help, we fixed the faulty relay module"
msgstr ""
"Merci infiniment. Avec votre aide, nous avons pu réparer le module relais "
"défectueux."

#: scripts/scenario_37_unwanted_visitors.lua:7741
msgctxt "satellites-comms"
msgid "Having satellite trouble?"
msgstr "Vous rencontrez des problèmes de satellite ?"

#: scripts/scenario_37_unwanted_visitors.lua:7748
#, lua-format
msgctxt "satellites-comms"
msgid ""
"It seems we've got an outdated servo motor. Replacement will take time. Our "
"repairman says he can fix it with %s, so we don't have to wait. Do you have "
"any?"
msgstr ""
"Il semble que nous ayons un servomoteur obsolète. Son remplacement prendra "
"du temps. Notre réparateur dit qu'il peut le réparer avec du %s, donc nous "
"n'aurons pas à attendre. En auriez-vous par hasard ?"

#: scripts/scenario_37_unwanted_visitors.lua:7781
#, lua-format
msgctxt "satellites-comms"
msgid "Give %s to %s"
msgstr "Donner du %s à %s"

#: scripts/scenario_37_unwanted_visitors.lua:7792
msgctxt "satellites-comms"
msgid "That worked. Thanks"
msgstr "Cela a fonctionné. Merci beaucoup."

#: scripts/scenario_37_unwanted_visitors.lua:7811
msgctxt "satellites-comms"
msgid "Can we help with your satellite?"
msgstr "Pouvons-nous vous aider avec votre satellite ?"

#: scripts/scenario_37_unwanted_visitors.lua:7818
#, lua-format
msgctxt "satellites-comms"
msgid "Only if you've got %s aboard your ship. Otherwise, we're stuck"
msgstr ""
"Seulement si vous avez le composant %s à bord de votre vaisseau. Sinon, nous "
"sommes coincés."

#: scripts/scenario_37_unwanted_visitors.lua:7862
msgctxt "satellites-comms"
msgid ""
"You have saved us a tremendous headache. We thought we'd have to wait two "
"months before we could fix the problem. Thanks"
msgstr ""
"Vous nous avez évité un énorme mal de tête. Nous pensions qu'il faudrait "
"attendre deux mois avant de pouvoir régler le problème.\n"
"Merci beaucoup."

#: scripts/scenario_37_unwanted_visitors.lua:7881
#: scripts/scenario_37_unwanted_visitors.lua:10296
msgctxt "station-comms"
msgid "Tell me more about your station"
msgstr "Dites m'en plus à propos de votre station"

#: scripts/scenario_37_unwanted_visitors.lua:7884
#: scripts/scenario_37_unwanted_visitors.lua:10300
msgctxt "station-comms"
msgid "What would you like to know?"
msgstr "Qu'aimeriez-vous savoir ?"

#: scripts/scenario_37_unwanted_visitors.lua:7887
#: scripts/scenario_37_unwanted_visitors.lua:10303
msgctxt "stationGeneralInfo-comms"
msgid "General information"
msgstr "Informations générales"

#: scripts/scenario_37_unwanted_visitors.lua:7895
#: scripts/scenario_37_unwanted_visitors.lua:10311
msgctxt "stationStory-comms"
msgid "Station history"
msgstr "L'histoire de la station"

#: scripts/scenario_37_unwanted_visitors.lua:7908
#: scripts/scenario_37_unwanted_visitors.lua:10321
msgctxt "gossip-comms"
msgid "Gossip"
msgstr "Commérages"

#: scripts/scenario_37_unwanted_visitors.lua:7926
#: scripts/scenario_37_unwanted_visitors.lua:10024
#, lua-format
msgctxt "characterInfo-comms"
msgid "Tell me about %s"
msgstr "Parlez-moi de %s"

#: scripts/scenario_37_unwanted_visitors.lua:7936
#: scripts/scenario_37_unwanted_visitors.lua:10036
#, lua-format
msgctxt "characterInfo-comms"
msgid "Never heard of %s"
msgstr "Jamais entendu parler de %s."

#: scripts/scenario_37_unwanted_visitors.lua:7942
#: scripts/scenario_37_unwanted_visitors.lua:10043
#, lua-format
msgctxt "characterInfo-comms"
msgid "%s died last week. The funeral was yesterday"
msgstr "%s est décédé la semaine dernière. L'enterrement a eu lieu hier."

#: scripts/scenario_37_unwanted_visitors.lua:7949
#: scripts/scenario_37_unwanted_visitors.lua:10050
#, lua-format
msgctxt "characterInfo-comms"
msgid "%s? Who's %s? There's nobody here named %s"
msgstr "%s ? Qui est %s ? Il n'y a personne ici qui s'appelle %s."

#: scripts/scenario_37_unwanted_visitors.lua:7958
#: scripts/scenario_37_unwanted_visitors.lua:10059
#, lua-format
msgctxt "characterInfo-comms"
msgid "We don't talk about %s. They are gone and good riddance"
msgstr "Pas envie de parler de %s. Ils sont partis et bon débarras."

#: scripts/scenario_37_unwanted_visitors.lua:7965
#: scripts/scenario_37_unwanted_visitors.lua:10066
#, lua-format
msgctxt "characterInfo-comms"
msgid "I think %s moved away"
msgstr "Je pense que %s a déménagé."

#: scripts/scenario_37_unwanted_visitors.lua:7972
#: scripts/scenario_37_unwanted_visitors.lua:10073
#, lua-format
msgctxt "characterInfo-comms"
msgid ""
"My aunt's neighbor's second cousin is named %s. However, %s lives far away "
"from here."
msgstr ""
"Le cousin germain du voisin de ma tante s'appelle %s. Cependant, %s habite "
"loin d'ici."

#: scripts/scenario_37_unwanted_visitors.lua:8010
msgctxt "station-comms"
msgid "Request access to isolated transporter pad"
msgstr "Demander l'accès à l'aire de transport isolée"

#: scripts/scenario_37_unwanted_visitors.lua:8015
msgctxt "station-comms"
msgid "That will damage your reputation. Do you wish to proceed?"
msgstr "Cela va nuire à votre réputation. Souhaitez-vous continuer ?"

#: scripts/scenario_37_unwanted_visitors.lua:8021
msgctxt "station-comms"
msgid "Proceed regardless of the reputation cost"
msgstr "Continuer quel que soit le coût en réputation"

#: scripts/scenario_37_unwanted_visitors.lua:8031
msgctxt "station-comms"
msgid ""
"You are transported to an unknown location. A small man in front of a vast "
"array of virtual monitors showing constantly changing pictures of different "
"planetary systems asks you what you want"
msgstr ""
"...Vous êtes transporté vers un lieu inconnu.\n"
"Un petit homme devant une vaste gamme de moniteurs virtuels montrant des "
"images en constante évolution de différents systèmes planétaires vous "
"demande ce que vous voulez."

#: scripts/scenario_37_unwanted_visitors.lua:8036
#: scripts/scenario_37_unwanted_visitors.lua:8083
#: scripts/scenario_37_unwanted_visitors.lua:8186
#, lua-format
msgctxt "station-comms"
msgid "Slow orbital speed of %s"
msgstr "Réduire la vitesse orbitale de %s"

#: scripts/scenario_37_unwanted_visitors.lua:8050
msgctxt "station-comms"
msgid "He twists a small dial and says, 'Done.'"
msgstr ""
"...Le petit homme tourne un petit cadran et dit :\n"
"\"Terminé\""

#: scripts/scenario_37_unwanted_visitors.lua:8060
#, lua-format
msgctxt "station-comms"
msgid "Slow orbital speed of the moon orbiting %s"
msgstr "Réduire la vitesse orbitale de la lune en orbite autour de %s"

#: scripts/scenario_37_unwanted_visitors.lua:8075
msgctxt "station-comms"
msgid "He moves a slider and says, 'OK.'"
msgstr ""
"...Le petit homme déplace un curseur et dit :\n"
"\"OK\""

#: scripts/scenario_37_unwanted_visitors.lua:8097
msgctxt "station-comms"
msgid "He types in a couple of numbers and says, 'Happy?'"
msgstr ""
"...Le petit homme tape quelques chiffres et dit :\n"
"\"Heureux ?\""

#: scripts/scenario_37_unwanted_visitors.lua:8107
#, lua-format
msgctxt "station-comms"
msgid "Slow orbital speed of stations orbiting %s"
msgstr "Réduire la vitesse orbitale des stations en orbite autour de %s"

#: scripts/scenario_37_unwanted_visitors.lua:8118
msgctxt "station-comms"
msgid "He flips a couple of switches and says, 'I love programmable stations'"
msgstr ""
"...Le petit homme actionne quelques interrupteurs et dit :\n"
"\"J'adore les stations programmables\""

#: scripts/scenario_37_unwanted_visitors.lua:8128
#: scripts/scenario_37_unwanted_visitors.lua:8210
#, lua-format
msgctxt "station-comms"
msgid "Slow orbital speed of the inner belt around %s"
msgstr "Réduire la vitesse orbitale de la ceinture intérieure autour de %s"

#: scripts/scenario_37_unwanted_visitors.lua:8148
msgctxt "station-comms"
msgid "He rubs one of the monitors a bit and says 'that should do it.'"
msgstr ""
"...Le petit homme frotte un peu l'un des moniteurs et dit :\n"
"\"ça devrait suffire\""

#: scripts/scenario_37_unwanted_visitors.lua:8158
#: scripts/scenario_37_unwanted_visitors.lua:8241
#, lua-format
msgctxt "station-comms"
msgid "Slow orbital speed of the outer belt around %s"
msgstr "Réduire la vitesse orbitale de la ceinture extérieure autour de %s"

#: scripts/scenario_37_unwanted_visitors.lua:8178
msgctxt "station-comms"
msgid ""
"He says, 'if you insist' and opens a small panel in the wall and enters a "
"code on a keypad."
msgstr ""
"...Le petit homme dit « si vous insistez », ouvre un petit panneau dans le "
"mur et saisit un code sur un clavier."

#: scripts/scenario_37_unwanted_visitors.lua:8200
msgctxt "station-comms"
msgid ""
"He sighs, stands up, grabs a large lever and pulls it about two inches "
"towards him then says, 'there.'"
msgstr ""
"...Le petit homme soupire, se lève, attrape un grand levier et le ramène à "
"environ 5 cm vers lui, puis dit :\n"
"\"Là\""

#: scripts/scenario_37_unwanted_visitors.lua:8231
msgctxt "station-comms"
msgid ""
"He pulls a keyboard out from under his desk, types a couple of things and "
"says, 'Alright.'"
msgstr ""
"...Le petit homme sort un clavier de sous son bureau, tape quelques mots et "
"dit :\n"
"\"Très bien\""

#: scripts/scenario_37_unwanted_visitors.lua:8268
msgctxt "station-comms"
