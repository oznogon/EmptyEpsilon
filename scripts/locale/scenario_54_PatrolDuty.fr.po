msgstr "Facile"

msgctxt "Enemies"
msgid "Fewer or weaker enemies"
msgstr "Ennemis moins nombreux et/ou plus faibles."

msgctxt "Enemies"
msgid "Normal"
msgstr "Normale"

msgctxt "Enemies"
msgid "Normal number or strength of enemies"
msgstr "Difficulté normale."

msgctxt "Enemies"
msgid "Hard"
msgstr "Difficile"

msgctxt "Enemies"
msgid "More or stronger enemies"
msgstr "Ennemis plus nombreux et/ou plus puissants."

