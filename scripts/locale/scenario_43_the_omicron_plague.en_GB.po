#: scripts/scenario_43_the_omicron_plague.lua:10074
msgctxt "mission3th-comms"
msgid ""
"We welcome any help you might provide. It would facilitate our survival."
msgstr ""

#: scripts/scenario_43_the_omicron_plague.lua:10080
msgctxt "mission3th-comms"
msgid "Could you provide us with your location?"
msgstr ""

#: scripts/scenario_43_the_omicron_plague.lua:10087
#, lua-format
msgctxt "mission3th-comms"
msgid "You mean %s did not tell you where to find us?"
