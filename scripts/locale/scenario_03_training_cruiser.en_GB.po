msgid "escaped."
msgstr "escaped."

#: scripts/scenario_03_training_cruiser.lua:228
msgctxt "msgMainscreen-bonusTarget"
msgid "destroyed."
msgstr "destroyed."

#: scripts/scenario_03_training_cruiser.lua:234
#, lua-format
msgctxt "msgMainscreen"
msgid ""
"Mission Complete.\n"
"Your Time: %d\n"
"Bonus target %s\n"
"\n"
"If you feel ready for combat, play scenario 'Basic Battle'.\n"
"If you want to try another ship, play the next training mission.\n"
"\n"
"If you need more practice, play this training again\n"
"with different stations assigned to your crew members."
msgstr "Mission Complete.\nYour Time: %d\nBonus target %s\n\nIf you feel ready for combat, play scenario 'Basic Battle'.\nIf you want to try another ship, play the next training mission.\n\nIf you need more practice, play this training again\nwith different stations assigned to your crew members."
