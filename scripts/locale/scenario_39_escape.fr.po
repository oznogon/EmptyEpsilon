msgstr ""
"[Ingénierie] Avec notre coque à %i, espérons que nos boucliers tiennent le "
"coup."

#: scripts/scenario_39_escape.lua:6422
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You won't get away so easily."
msgstr "[Vaisseau %s] Vous ne vous en sortirez pas si facilement."

#: scripts/scenario_39_escape.lua:6426
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You can run, but you can't hide."
msgstr ""
"[Vaisseau %s] Vous pouvez fuir, mais vous ne pourrez pas vous cacher ha ha "
"ha."

#: scripts/scenario_39_escape.lua:6428
#, fuzzy, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I will get you yet."
msgstr "[Vaisseau %s] Je vais encore vous capturer et vous remettre en prison."

#: scripts/scenario_39_escape.lua:6431
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I will hunt you down and destroy you like vermin."
msgstr ""
"[Vaisseau %s] Je vais vous traquer et vous détruire comme de la vermine."

#: scripts/scenario_39_escape.lua:6435
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] Slow down, I promise not to destroy you immediately."
msgstr "[Vaisseau %s] Ralentissez. Je promets de ne pas vous faire de mal."

#: scripts/scenario_39_escape.lua:6475
msgctxt "Boris-incCall"
msgid ""
"You don't steal from Boris Junk Yard without consequences. I'm coming for "
"you."
msgstr ""
"Vous ne pouvez pas voler du matériel de la casse Boris sans conséquences.\n"
"Je viens m'occuper de vous !"

#: scripts/scenario_39_escape.lua:6479
msgctxt "Boris-incCall"
msgid "I saw you steal that ship. You'll rue the day."
msgstr ""
"Je vous ai vu voler ce vaisseau.\n"
"Je vais vous faire regretter d'être nés !"

#: scripts/scenario_39_escape.lua:6483
msgctxt "Boris-incCall"
msgid "Stealing a ship, eh? We'll just see about that."
msgstr ""
"Alors comme ça, on vole un vaisseau ? Tranquillement...\n"
"Bin on va voir ca !"

#: scripts/scenario_39_escape.lua:6487
msgctxt "Boris-incCall"
msgid ""
"You must pay for the ship you stole from Boris Junk Yard... with your life."
msgstr ""
"Vous devez payer le vaisseau que vous avez volé à la casse Boris…\n"
"Le payer de votre vie."

#: scripts/scenario_39_escape.lua:6504
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You can't get rid of me that easily."
msgstr "[Vaisseau %s] Vous ne vous débarrasserez pas de moi aussi facilement."

#: scripts/scenario_39_escape.lua:6505
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I'll be back."
msgstr ""
"[Vaisseau %s] Comme l'a dis un célèbre cyborg : I'll be back !  (Je "
"reviendrai !)"

#: scripts/scenario_39_escape.lua:6506
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I've got plenty of ships."
msgstr "[Vaisseau %s] J'ai des tonnes de vaisseaux."

#: scripts/scenario_39_escape.lua:6507
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] This is merely a temporary setback."
msgstr "[Vaisseau %s] Il s'agit simplement d'un revers temporaire."

#: scripts/scenario_39_escape.lua:6532
msgctxt "crewRepair-shipLog"
msgid ""
"Repair crew thinks they can use the space debris recently acquired to make "
"repair parts for the jump drive. They are starting the fabrication process "
"now."
msgstr ""
"[Réparations] L'équipe de réparation pense pouvoir utiliser les débris "
"spatiaux récemment récupérés pour fabriquer des pièces de réparation pour le "
"système de téléportation.\n"
"Ils commencent dès maintenant la fabrication des pièces."

#: scripts/scenario_39_escape.lua:6547
msgctxt "crewRepair-shipLog"
msgid ""
"Repair crew finished jump drive part fabrication. They believe the jump "
"drive should be functional soon."
msgstr ""
"[Réparations] L'équipe de réparation a terminé la fabrication des pièces "
"pour le système de téléportation.\n"
"Ils pensent qu'il devrait bientôt être fonctionnel."

#: scripts/scenario_39_escape.lua:6567
msgctxt "victory-msgMainscreen"
msgid ""
"Congratulations! You escaped the Kraylor clutches and returned all your "
"gathered data on the Kraylor to the Human Navy."
msgstr ""
"[Message du Quartier Général]\n"
"\n"
"Toutes nos félicitations ! Vous avez échappé aux griffes des Kraylors et "
"transmis avec succès des informations essentielles à la Marine humaine."

#: scripts/scenario_39_escape.lua:6957
