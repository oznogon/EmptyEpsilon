msgstr ""
"Es gibt einige Berichte von Sichtungen eines Objekts, von der Station Nakor "
"aus in Richtung 135."

#: scripts/scenario_16_deliver_ambassador_gremus.lua:2316
msgctxt "artifact-comms"
