#: scripts/scenario_16_deliver_ambassador_gremus.lua:2306
msgctxt "artifact-comms"
msgid "Heard of any artifacts near Nakor?"
msgstr "Haben Sie von irgendwelchen Artefakten in der Nähe von Nakor gehört?"

#: scripts/scenario_16_deliver_ambassador_gremus.lua:2309
msgctxt "artifact-comms"
msgid ""
"Some have reported seeing object on approximate heading of 315 from Nakor "
