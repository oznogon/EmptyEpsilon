#: scripts/scenario_16_deliver_ambassador_gremus.lua:839
#, lua-format
msgctxt "audio-incCall"
msgid ""
"(Ambassador Gremus) Thanks for transporting me, %s. Tensions are high, but I "
"think negotiations will succeed.\n"
"In the meantime, be careful of hostile ships."
msgstr ""
"(Botschafter Gremus) Danke für den Transport, %s. Es herrschen viele "
"Spannungen, aber ich glaube, die Verhandlungen werden erfolgreich sein.\n"
"In der Zwischenzeit: Achten Sie auf feindliche Schiffe."

#: scripts/scenario_16_deliver_ambassador_gremus.lua:854
msgctxt "audio-incCall"
