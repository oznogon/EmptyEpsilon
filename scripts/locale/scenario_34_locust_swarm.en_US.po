#: scripts/scenario_34_locust_swarm.lua:2675
#, lua-format
msgctxt "orders-comms"
msgid ""
"Hello %s,\n"
"Our sensors have picked up numerous Exuari ships."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2680
msgctxt "orders-comms"
msgid "How many is numerous?"
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2682
#, lua-format
msgctxt "orders-comms"
msgid "Approximately %s"
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2685
msgctxt "orders-comms"
msgid "That's quite a few. What kind of ships?"
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2691
#, lua-format
msgctxt "orders-comms"
msgid "They look like %ss. The computer calls them locusts. They're very fast."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2697
msgctxt "orders-comms"
msgid "Should we be worried?"
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2702
msgctxt "orders-comms"
msgid ""
"Individually, they should be easy to handle. As a group, they could be a "
"problem."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2708
msgctxt "orders-comms"
msgid "What do you want us to do about them?"
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2714
msgctxt "orders-comms"
msgid "Get rid of them. Every last one of them."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2734
#, lua-format
msgctxt "orders-comms"
msgid ""
"Greetings %s,\n"
"We've got an update for you on those Exuari Locusts."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2739
msgctxt "orders-comms"
msgid "Tell us about it."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2743
msgctxt "orders-comms"
msgid "All the Exuari on our sensors have started moving."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2746
msgctxt "orders-comms"
msgid "Where are they going?"
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2750
msgctxt "orders-comms"
msgid ""
"We are not quite sure, but they seem to be converging on a central location."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2756
msgctxt "orders-comms"
msgid "That could make it harder for us to get rid of them."
msgstr ""

#: scripts/scenario_34_locust_swarm.lua:2762
msgctxt "orders-comms"
msgid ""
"How perceptive of you! We are so glad you are out there working to rid us of "
"these Locusts. Keep up the good work!"
msgstr ""

