# Scenario setting
msgctxt "setting"
msgid "Tracking"
msgstr "Flaggeninfo"

msgctxt "setting"
msgid "Configures information given about flag."
msgstr "Legt die Informationen zu den Flaggen fest."

msgctxt "Tracking"
msgid "Normal"
msgstr "Normal"

msgctxt "Tracking"
msgid ""
"Drop: Kraylor or Human Navy flag dropped (main  screen). Grab: The Kraylor "
"or Human Navy picked up your flag (main screen and ship log)"
msgstr ""
"Zurücklassen: Name der Seite, die die Flagge zurückgelassen hat "
"(Hauptschirm)\n"
"Aufnehmen: Name der Seite, die die Flagge aufgenommen hat (Hauptschirm und "
"Logbuch)"

msgctxt "Tracking"
msgid "Easy"
msgstr "Einfach"

msgctxt "Tracking"
msgid ""
"Drop: ShipName dropped Kraylor or Human Navy flag (main screen). Grab: "
"Kraylor or Human Navy ship ShipName picked up your flag (main screen and "
"ship log)"
msgstr ""
"Zurücklassen: Name des Schiffs, das die Flagge zurückgelassen hat "
"(Hauptschirm)\n"
"Aufnehmen: Name des Schiffs, das die Flagge aufgenommen hat (Hauptschirm und "
"Logbuch)"

msgctxt "Tracking"
msgid "Hard"
msgstr "Schwer"

msgctxt "Tracking"
msgid ""
"Drop: Flag dropped (main screen). Grab: Flag obtained (main screen). Flag "
"must be rescanned after drop"
msgstr ""
"Zurücklassen: Es wird nur erwähnt, dass eine Flagge zurückgelassen wurde "
"(Hauptschirm)\n"
"Aufnehmen: Es wird nur erwähnt, dass eine Flagge aufgenommen wurde "
"(Hauptschirm und Logbuch)\n"
"Flagge muss nach Zurücklassen erst wieder neu gescannt werden, bevor sie "
"aufgenommen werden kann"

msgctxt "Tracking"
msgid "Secret"
msgstr "Geheim"

msgctxt "Tracking"
msgid ""
"Neither dropping nor grabbing the flag will produce a message. Flag must be "
"rescanned after drop"
msgstr ""
"Weder das Zurücklassen noch das Aufnehmen einer Flagge wird angezeigt\n"
"Flagge muss nach Zurücklassen erst wieder neu gescannt werden, bevor sie "
"aufgenommen werden kann"

