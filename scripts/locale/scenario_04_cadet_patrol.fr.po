# Scenario name
msgid "Cadet Patrol"
msgstr "Patrouille de cadets"

# Scenario description
msgid ""
"One Phobos class player ship, full of fresh academy graduates assigned to "
"patrol duty.\n"
"Beginner's mission. Players can save and restore if they remember their key. "
"The terrain differs each time the scenario runs.\n"
"Duration: 1-2 hours\n"
"\n"
"Voice actors:\n"
"Andrew \"Snow\" Kenny\n"
"Bart K7AAY\n"
"SANTAtheGREY\n"
"Xansta\n"
"\n"
"Version 1 Mar 2025"
msgstr ""

