msgstr ""

#: scripts/scenario_32_planet_devourer.lua:4335
msgctxt "mission-comms"
msgid "How can we get those plans?"
msgstr ""

#: scripts/scenario_32_planet_devourer.lua:4341
msgctxt "mission-comms"
msgid "You can't"
msgstr ""

#: scripts/scenario_32_planet_devourer.lua:4347
