msgid "Warden"
msgstr "Warden"

#: scripts/shiptemplates/exuari/corvettes.lua:62
#: scripts/shiptemplates/exuari/corvettes.lua:87
msgctxt "subclass"
msgid "Artillery"
msgstr "Artillery"

#: scripts/shiptemplates/exuari/corvettes.lua:67
msgid ""
"The Exuari Warden is a heavy artillery corvette that fires volleys of "
"missiles from forward-facing tubes. It has only a single point-defense "
"turret beam weapon."
msgstr "The Exuari Warden is a heavy artillery corvette that fires volleys of missiles from forward-facing tubes. It has only a single point-defence turret beam weapon."

#: scripts/shiptemplates/exuari/corvettes.lua:86
msgctxt "ship"
msgid "Flash"
msgstr "Flash"

#: scripts/shiptemplates/exuari/corvettes.lua:92
msgid ""
"The Exuari Flash is a special artillery sniper designed to deal large "
"amounts of damage quickly and from a distance before escaping. Its simple "
"design consists of a freighter hull full of nuclear weapons, and rumors "
"suggest that the Exuari refit captured freighters into Flashes."
msgstr "The Exuari Flash is a special artillery sniper designed to deal large amounts of damage quickly and from a distance before escaping. Its simple design consists of a freighter hull full of nuclear weapons, and rumours suggest that the Exuari refit captured freighters into Flashes."

#: scripts/shiptemplates/exuari/corvettes.lua:106
