#: scripts/shiptemplates/corvette.lua:367
msgctxt "subclass"
msgid "Carrier"
msgstr "Carrier"

#: scripts/shiptemplates/corvette.lua:368
msgid ""
"The Saipan mixes most of the strengths of the corvette class with carrier "
"capability. The weapons compare favorably with other corvette class ships. "
"Having fighters use the Saipan as a base can really ruin an enemy's day"
msgstr "The Saipan mixes most of the strengths of the corvette class with carrier capability. The weapons compare favourably with other corvette class ships. Having fighters use the Saipan as a base can really ruin an enemy's day"
