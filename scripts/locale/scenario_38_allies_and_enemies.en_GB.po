msgstr "You are fully loaded and ready to explode things."

#: scripts/scenario_38_allies_and_enemies.lua:7985
msgctxt "ammo-comms"
msgid ""
"We generously resupplied you with some weapon charges.\n"
"Put them to good use."
msgstr "We generously resupplied you with some weapon charges.\nPut them to good use."

#: scripts/scenario_38_allies_and_enemies.lua:7990
#: scripts/scenario_38_allies_and_enemies.lua:8027
#: scripts/scenario_38_allies_and_enemies.lua:8033
msgctxt "needRep-comms"
