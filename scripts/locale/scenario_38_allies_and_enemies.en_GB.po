msgid "Not really. We need your help"
msgstr "Not really. We need your help"

#: scripts/scenario_38_allies_and_enemies.lua:3182
msgctxt "doctor-comms"
msgid ""
"I'm sorry, but I'm too busy right now\n"
"[Dr. Thultris closes her door]"
msgstr ""
"I'm sorry, but I'm too busy right now\n"
"[Dr. Thultris closes her door]"

#: scripts/scenario_38_allies_and_enemies.lua:3193
