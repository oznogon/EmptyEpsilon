msgstr "[Engineering tech] With our hull at %i, we better hope our shields hold"

#: scripts/scenario_39_escape.lua:6425
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You won't get away so easily."
msgstr "[%s] You won't get away so easily."

#: scripts/scenario_39_escape.lua:6429
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You can run, but you can't hide."
msgstr "[%s] You can run, but you can't hide."

#: scripts/scenario_39_escape.lua:6431
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I will get you yet."
msgstr "[%s] I will get you yet."

#: scripts/scenario_39_escape.lua:6434
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I will hunt you down and destroy you like vermin."
msgstr "[%s] I will hunt you down and destroy you like vermin."

#: scripts/scenario_39_escape.lua:6438
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] Slow down, I promise not to destroy you immediately."
msgstr "[%s] Slow down, I promise not to destroy you immediately."

#: scripts/scenario_39_escape.lua:6478
msgctxt "Boris-incCall"
msgid ""
"You don't steal from Boris Junk Yard without consequences. I'm coming for "
"you."
msgstr "You don't steal from Boris Junk Yard without consequences. I'm coming for you."

#: scripts/scenario_39_escape.lua:6482
msgctxt "Boris-incCall"
msgid "I saw you steal that ship. You'll rue the day."
msgstr "I saw you steal that ship. You'll rue the day."

#: scripts/scenario_39_escape.lua:6486
msgctxt "Boris-incCall"
msgid "Stealing a ship, eh? We'll just see about that."
msgstr "Stealing a ship, eh? We'll just see about that."

#: scripts/scenario_39_escape.lua:6490
msgctxt "Boris-incCall"
msgid ""
"You must pay for the ship you stole from Boris Junk Yard... with your life."
msgstr "You must pay for the ship you stole from Boris Junk Yard... with your life."

#: scripts/scenario_39_escape.lua:6507
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You can't get rid of me that easily."
msgstr "[%s] You can't get rid of me that easily."

#: scripts/scenario_39_escape.lua:6508
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I'll be back."
msgstr "[%s] I'll be back."

#: scripts/scenario_39_escape.lua:6509
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I've got plenty of ships."
msgstr "[%s] I've got plenty of ships."

#: scripts/scenario_39_escape.lua:6510
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] This is merely a temporary setback."
msgstr "[%s] This is merely a temporary setback."

#: scripts/scenario_39_escape.lua:6535
msgctxt "crewRepair-shipLog"
msgid ""
"Repair crew thinks they can use the space debris recently acquired to make "
"repair parts for the jump drive. They are starting the fabrication process "
"now."
msgstr "Repair crew thinks they can use the space debris recently acquired to make repair parts for the jump drive. They are starting the fabrication process now."

#: scripts/scenario_39_escape.lua:6550
msgctxt "crewRepair-shipLog"
msgid ""
"Repair crew finished jump drive part fabrication. They believe the jump "
"drive should be functional soon."
msgstr "Repair crew finished jump drive part fabrication. They believe the jump drive should be functional soon."

#: scripts/scenario_39_escape.lua:6570
