#: scripts/scenario_19_what_the_dickens.lua:635
msgctxt "riverWarning-shipLog"
msgid ""
"Reminder to all newcomers to the London area: the river area damages ship "
"systems. Jump the river or use the provided bridges"
msgstr ""
"[MESSAGE D'AVERTISSEMENT]\n"
"Rappel à tous les nouveaux arrivants dans la région de Londres : la zone "
"fluviale endommage les systèmes des vaisseaux. Sautez la rivière ou utilisez "
"les ponts fournis."

#: scripts/scenario_19_what_the_dickens.lua:730
msgctxt "station-comms"
msgid "We are under attack! No time for chatting!"
msgstr ""
"Nous sommes sous le feu de l'ennemi !\n"
"Pas le temps de bavarder !"

#: scripts/scenario_19_what_the_dickens.lua:747
