# Scenario setting
msgctxt "setting"
msgid "Unique Ship"
msgstr "Unique Ship"

msgctxt "setting"
msgid "Choose player ship outside of standard player ship list"
msgstr "Choose player ship outside of standard player ship list"

msgctxt "Unique Ship"
msgid "None"
msgstr "None"

msgctxt "Unique Ship"
msgid "None: just use standard player ship list on spawn screen"
msgstr "None: just use standard player ship list on spawn screen"

msgctxt "Unique Ship"
msgid "Spinstar"
msgstr "Spinstar"

msgctxt "Unique Ship"
msgid ""
"Based on Atlantis, has spinal beam: narrow, long range, rapid firing, 5 "
"second duration, 30 second recharge, fewer tubes, weaker shields and hull, "
"warp, faster maneuver"
msgstr "Based on Atlantis, has spinal beam: narrow, long range, rapid firing, 5 second duration, 30 second recharge, fewer tubes, weaker shields and hull, warp, faster manoeuvre"

msgctxt "Unique Ship"
msgid "Narsil"
msgstr "Narsil"

msgctxt "Unique Ship"
msgid ""
"Based on Atlantis, slower impulse, faster maneuver, warp, weaker hull and "
"shields, add forward HVLI tube and side beam turrets"
msgstr "Based on Atlantis, slower impulse, faster manoeuvre, warp, weaker hull and shields, add forward HVLI tube and side beam turrets"

msgctxt "Unique Ship"
msgid "Blazon"
msgstr "Blazon"

msgctxt "Unique Ship"
msgid ""
"Based on Striker, faster impulse and maneuver, stronger shields, narrower "
"beams, add beam, add missiles"
msgstr "Based on Striker, faster impulse and manoeuvre, stronger shields, narrower beams, add beam, add missiles"

msgctxt "Unique Ship"
msgid "Headhunter"
msgstr "Headhunter"

msgctxt "Unique Ship"
msgid ""
"Based on Piranha, shorter jump, stronger hull and shields, add beam, one "
"fewer mining tube, fewer mines and nukes, more EMPs"
msgstr "Based on Piranha, shorter jump, stronger hull and shields, add beam, one fewer mining tube, fewer mines and nukes, more EMPs"

msgctxt "Unique Ship"
msgid "Simian"
msgstr "Simian"

msgctxt "Unique Ship"
msgid ""
"Based on missile cruiser, 20k jump, add beam, weaker hull, fewer tubes and "
"missiles"
msgstr "Based on missile cruiser, 20k jump, add beam, weaker hull, fewer tubes and missiles"

msgctxt "Unique Ship"
msgid "Spyder"
msgstr "Spyder"

msgctxt "Unique Ship"
msgid "Based on Atlantis, slower impulse, extra tube, angled tubes"
msgstr "Based on Atlantis, slower impulse, extra tube, angled tubes"

msgctxt "Unique Ship"
msgid "Sting"
msgstr "Sting"

msgctxt "Unique Ship"
msgid ""
"Based on Hathcock, faster impulse, warp, add mining tube, no nukes or EMPs"
msgstr "Based on Hathcock, faster impulse, warp, add mining tube, no nukes or EMPs"

