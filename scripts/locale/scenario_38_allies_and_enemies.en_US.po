msgid "Dr. Thultris resides on station %s"
msgstr ""

#: scripts/scenario_38_allies_and_enemies.lua:5138
msgctxt "doctor-msgMainscreen"
msgid "Arlenian Admiral Koshenz dies"
msgstr ""

#: scripts/scenario_38_allies_and_enemies.lua:5146
#, lua-format
msgctxt "doctor-msgMainscreen"
msgid ""
