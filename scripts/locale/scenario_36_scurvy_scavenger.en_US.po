#: scripts/scenario_36_scurvy_scavenger.lua:7529
#, lua-format
msgctxt "ridExuari-incCall"
msgid ""
"[%s in %s] Hostile Exuari approach. Help us, please. We cannot defend "
"ourselves. Your ship is the only thing that stands between us and "
"destruction."
msgstr ""

#: scripts/scenario_36_scurvy_scavenger.lua:7538
#, lua-format
msgctxt "ridExuari-incCall"
msgid ""
"%s\n"
"\n"
"We think there is an Exuari base hiding in a nebula in sector %s"
msgstr ""

#: scripts/scenario_36_scurvy_scavenger.lua:7550
#, lua-format
