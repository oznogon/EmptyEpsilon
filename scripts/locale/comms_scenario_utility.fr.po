#: scripts/comms_scenario_utility.lua:352
#: scripts/comms_scenario_utility.lua:429
#: scripts/comms_scenario_utility.lua:1168
#: scripts/comms_scenario_utility.lua:5325
#: scripts/comms_scenario_utility.lua:5383
msgctxt "situationReport-comms"
msgid ""
"A recent reactor failure has put us on auxiliary power, so we cannot "
"recharge ships."
msgstr ""
"- Énergie : une récente panne de réacteur nous a mis sous tension "
"auxiliaire, nous ne pouvons donc pas recharger les vaisseaux."

#: scripts/comms_scenario_utility.lua:355
#: scripts/comms_scenario_utility.lua:430
#: scripts/comms_scenario_utility.lua:1169
#: scripts/comms_scenario_utility.lua:5328
#: scripts/comms_scenario_utility.lua:5384
msgctxt "situationReport-comms"
msgid "A damaged power coupling makes it too dangerous to recharge ships."
msgstr ""
"- Énergie : un couplage électrique défectueux rend la recharge des vaisseaux "
"trop risquée."

#: scripts/comms_scenario_utility.lua:358
#: scripts/comms_scenario_utility.lua:431
#: scripts/comms_scenario_utility.lua:1170
#: scripts/comms_scenario_utility.lua:5331
#: scripts/comms_scenario_utility.lua:5385
msgctxt "situationReport-comms"
msgid ""
"An asteroid strike damaged our solar cells and we are short on power, so we "
"can't recharge ships right now."
msgstr ""
"- Énergie : une frappe d'astéroïde a endommagé nos cellules solaires et nous "
"manquons de puissance, nous ne pouvons donc pas recharger les vaisseaux pour "
"le moment."

#: scripts/comms_scenario_utility.lua:363
#: scripts/comms_scenario_utility.lua:418
#: scripts/comms_scenario_utility.lua:1154
#: scripts/comms_scenario_utility.lua:5336
#: scripts/comms_scenario_utility.lua:5373
msgctxt "situationReport-comms"
msgid "We're out of the necessary materials and supplies for hull repair."
msgstr ""
"- Coque : nous n'avons plus les matériaux et fournitures nécessaires pour "
"réparer la coque."

#: scripts/comms_scenario_utility.lua:366
#: scripts/comms_scenario_utility.lua:419
#: scripts/comms_scenario_utility.lua:1155
#: scripts/comms_scenario_utility.lua:5339
#: scripts/comms_scenario_utility.lua:5374
msgctxt "situationReport-comms"
msgid "Hull repair automation unavailable while it is undergoing maintenance."
msgstr ""
"- Coque : l'automatisation de réparation de la coque n'est pas disponible "
"pendant la maintenance."

#: scripts/comms_scenario_utility.lua:369
#: scripts/comms_scenario_utility.lua:420
#: scripts/comms_scenario_utility.lua:1156
#: scripts/comms_scenario_utility.lua:5342
#: scripts/comms_scenario_utility.lua:5375
msgctxt "situationReport-comms"
msgid "All hull repair technicians quarantined to quarters due to illness."
msgstr ""
"- Coque : tous les techniciens de réparation de coque sont en quarantaine "
"dans leur quartiers pour cause de maladie."

#: scripts/comms_scenario_utility.lua:374
#: scripts/comms_scenario_utility.lua:407
#: scripts/comms_scenario_utility.lua:1140
#: scripts/comms_scenario_utility.lua:5347
#: scripts/comms_scenario_utility.lua:5363
msgctxt "situationReport-comms"
msgid "Cannot replenish scan probes due to fabrication unit failure."
msgstr ""
"- Sondes : impossible de réapprovisionner les sondes en raison d'une "
"défaillance de l'unité de fabrication."

#: scripts/comms_scenario_utility.lua:377
#: scripts/comms_scenario_utility.lua:408
#: scripts/comms_scenario_utility.lua:1141
#: scripts/comms_scenario_utility.lua:5350
#: scripts/comms_scenario_utility.lua:5364
msgctxt "situationReport-comms"
msgid "Parts shortage prevents scan probe replenishment."
msgstr ""
"- Sondes : le manque de pièces empêche le réapprovisionnement des sondes."

#: scripts/comms_scenario_utility.lua:380
#: scripts/comms_scenario_utility.lua:409
#: scripts/comms_scenario_utility.lua:1142
#: scripts/comms_scenario_utility.lua:5353
#: scripts/comms_scenario_utility.lua:5365
msgctxt "situationReport-comms"
msgid ""
"Station management has curtailed scan probe replenishment for cost cutting "
"reasons."
msgstr ""
"- Sondes : les gestionnaires de la station ont réduit le réapprovisionnement "
"des sondes pour des raisons de réduction des coûts."

