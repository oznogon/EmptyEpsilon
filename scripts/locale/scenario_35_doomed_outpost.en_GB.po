"We have taken on your repair crewmember as a new crewmember on our ship."
msgstr ""
"We have taken on your repair crewmember as a new crewmember on our ship."

#: scripts/scenario_35_doomed_outpost.lua:6916
#: scripts/scenario_35_doomed_outpost.lua:7149
#: scripts/scenario_35_doomed_outpost.lua:7387
