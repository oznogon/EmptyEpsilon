"crewmember on our ship."

#: scripts/scenario_35_doomed_outpost.lua:7055
#: scripts/scenario_35_doomed_outpost.lua:7292
#: scripts/scenario_35_doomed_outpost.lua:7526
msgctxt "ship-comms"
msgid "I talked to the captain, but he still needs convincing."
msgstr "I talked to the captain, but he still needs convincing."

