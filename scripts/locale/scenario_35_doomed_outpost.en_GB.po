#: scripts/scenario_35_doomed_outpost.lua:7036
#: scripts/scenario_35_doomed_outpost.lua:7169
#: scripts/scenario_35_doomed_outpost.lua:7273
#: scripts/scenario_35_doomed_outpost.lua:7407
#: scripts/scenario_35_doomed_outpost.lua:7507
