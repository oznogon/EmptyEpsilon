msgid "Insufficient reputation"
msgstr "Insufficient reputation"

#: scripts/scenario_35_doomed_outpost.lua:6926
#: scripts/scenario_35_doomed_outpost.lua:7026
#: scripts/scenario_35_doomed_outpost.lua:7159
#: scripts/scenario_35_doomed_outpost.lua:7263
#: scripts/scenario_35_doomed_outpost.lua:7397
#: scripts/scenario_35_doomed_outpost.lua:7497
