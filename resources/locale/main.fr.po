msgid "Restocking sec/probe:"
msgstr "Secondes de réapprovisionnement par sonde :"

#: src/screens/gm/tweak.cpp:4413
msgctxt "tweak-tab"
msgid "Radar link"
msgstr "Lien radar"

#: src/screens/gm/tweak.cpp:4414
msgctxt "tweak-radar-link"
msgid ""
"Determines whether this entity is capable of receiving a radar link from "
"another entity, such as a probe, that has the Allow radar link component.\n"
"\n"
"Callback members on_link and on_unlink can't be tweaked via this dialog."
msgstr ""
"Détermine si cette entité peut recevoir un lien radar d'une autre entité, "
"comme une sonde, qui a le composant Autoriser le lien radar.\n"
"\n"
"Les membres callback on_link et on_unlink ne peuvent pas être modifiés via "
"cette boîte de dialogue."

#: src/screens/gm/tweak.cpp:4415
msgctxt "tweak-text"
msgid "Linked entity:"
msgstr "Entité liée :"

#: src/screens/gm/tweak.cpp:4418
msgctxt "tweak-tab"
msgid "Allow radar link"
msgstr "Autoriser le lien radar"

#: src/screens/gm/tweak.cpp:4419
msgctxt "tweak-radar-link"
msgid ""
"Marks this entity as a radar-linked probe. Its owner entity can link the "
"probe's radar to Probe Views on the Science and Operations crew screens."
msgstr ""
"Marque cette entité comme une sonde liée au radar. L'entité propriétaire "
"peut lier le radar de la sonde aux Vues sonde sur les écrans d'équipage "
"Science et Opérations."

#: src/screens/gm/tweak.cpp:4420 src/screens/gm/tweak.cpp:4709
